{
    "geode": "5.8.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081"
    },
    "version": "v1.0.0",
    "id": "goodxdeveloper.deepbot",
    "name": "deepbot",
    "developer": "goodxdeveloper",
    "description": "Universal free macro bot for Geometry Dash. Supports 18 formats, TPS-independent recording, no watermarks.",
    "repository": "https://github.com/goodxdeveloper/deepbot",
    "issues": {
        "info": "Report issues on GitHub",
        "url": "https://github.com/goodxdeveloper/deepbot/issues"
    },
    "tags": ["bot", "macro", "utility", "free"],
    "dependencies": [
        {
            "id": "geode.node-ids",
            "version": ">=1.0.0",
            "importance": "required"
        }
    ],
    "settings": {
        "show-button": {
            "name": "Show Menu Button",
            "description": "Show the deepbot button in the pause menu",
            "type": "bool",
            "default": true
        },
        "auto-save": {
            "name": "Auto Save Macros",
            "description": "Automatically save macros on level complete",
            "type": "bool",
            "default": true
        },
        "default-tps": {
            "name": "Default TPS",
            "description": "Default TPS for recording",
            "type": "int",
            "default": 240,
            "min": 60,
            "max": 1000
        }
    }
}